{
  "expo": {
    "name": "ParkLane",
    "slug": "parklane",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b1210"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.parklane.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1210"
      },
      "package": "local.parklane.app"
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
