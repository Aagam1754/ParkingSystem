PORT=4000

# Option A — discrete MySQL settings (local Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parking
# DB_SSL=false

# Option B — single URL (Render / managed MySQL)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/parking

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=*
PYTHON_ALPR_URL=http://127.0.0.1:5001
# On Render, PYTHON_ALPR_HOSTPORT is injected from the alpr service instead.

# Smart Parking Assistant (optional — works offline with live-data rules if unset)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ElevenLabs TTS for Assistant (Mic in → voice out)
# Get key: ElevenLabs → ElevenAPI / Developers → API Key
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
