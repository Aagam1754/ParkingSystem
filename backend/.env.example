PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parking
# Set true for cloud MySQL (Aiven, Railway, etc. / Render deploy)
DB_SSL=false
JWT_SECRET=parkai-admin-dev-secret-change-me
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=*
PYTHON_ALPR_URL=http://127.0.0.1:5001
# Or host only (Render): PYTHON_ALPR_HOST=parkingsystem-alpr.onrender.com
# Serve built admin UI from this API (used on Render)
SERVE_ADMIN=false

# Optional: set OPENAI_API_KEY for LLM replies (otherwise live-data rules engine)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ElevenLabs TTS — paste your API key below, then restart npm run dev:api
